{
  "name": "neko-tera-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AIオーケストレーションによる猫寺会話劇ショート動画制作システム",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Main out/master.mp4 --codec h264 --crf 16",
    "validate": "tsx pipeline/validate.ts",
    "select-voices": "tsx pipeline/select-voices.ts",
    "tts": "tsx pipeline/tts.ts",
    "mix": "tsx pipeline/mix.ts",
    "encode": "tsx pipeline/encode.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "p0:verify-input": "tsx pipeline/p0/fixed-input.ts --verify",
    "p0:verify-network": "tsx pipeline/p0/verify-network.ts --verify",
    "p0:render": "tsx pipeline/p0/render-baseline.ts",
    "p0:manifest": "tsx pipeline/p0/write-manifest.ts",
    "p0:validate": "tsx pipeline/p0/validate.ts",
    "p0:evaluate": "tsx pipeline/p0/evaluate.ts",
    "p0:present": "tsx pipeline/p0/present.ts",
    "p0:visual-integrity": "tsx pipeline/p0/visual-integrity.ts",
    "p0:negative-test": "tsx pipeline/p0/negative-test.ts",
    "p0:verify": "tsx pipeline/p0/verify.ts",
    "p0b:validate-contract": "tsx pipeline/p0b/validate-contract.ts",
    "n0:local-inventory": "tsx pipeline/n0/local-inventory.ts",
    "m3:validate-p1-run-definition": "tsx pipeline/m3/validate-p1-run-definition.ts",
    "docs:validate-anti-patterns": "tsx pipeline/docs/anti-patterns-ledger.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "dotenv": "^17.4.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "music-metadata": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
